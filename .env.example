# Copy to .env (git-ignored). Never commit real values.

# PayPal SANDBOX REST app (phase B). Production hosts are refused at startup.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini (free tier; spend is metered at list price, never charged)
GEMINI_API_KEY=
GEMINI_MODEL=
# Requests per minute allowed to the model (client-side limiter; 429s are retried)
GEMINI_RPM=10
# Output token cap per model call (a whole index.html travels in one tool call)
MAX_OUTPUT_TOKENS=8192

# Payment rail: paypal | mock
RAIL=mock

# 1 = serve LLM calls from llm_cache for a deterministic demo
DEMO_REPLAY=0

# List price used for metering, integer micro-USD per million tokens
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0
